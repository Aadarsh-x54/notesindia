AI_SERVICE_API_KEY=CHANGE_ME_INTERNAL_AI_SERVICE_SECRET_KEY_NOTESINDIA
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Swap models freely without touching Java: qwen2.5:1.5b (8GB CPU), qwen2.5:3b, qwen3:8b
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TEMPERATURE=0.2
OLLAMA_CONNECT_TIMEOUT=10
OLLAMA_READ_TIMEOUT=180
OLLAMA_NUM_CTX=4096
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_TYPE=faiss
VECTOR_STORE_DIR=./data/vectorstore
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MIN_SCORE=0.15
