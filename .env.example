# ==============================================================================
# NotesIndia — Environment Configuration
# Copy this file to .env and replace placeholder secrets before running.
# ==============================================================================

# PostgreSQL Database
POSTGRES_DB=notesindia
POSTGRES_USER=notesindia
POSTGRES_PASSWORD=notesindia_dev_password_change_me
POSTGRES_PORT=5432

# Redis Cache & Rate Limiting
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Object Storage (local | s3)
STORAGE_PROVIDER=s3
STORAGE_LOCAL_DIR=./storage/uploads
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=notesindia-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_change_me
S3_PATH_STYLE_ACCESS=true

# Java Spring Boot Backend
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker
JWT_SECRET=CHANGE_ME_TO_A_SECURE_256_BIT_BASE64_OR_LONG_RANDOM_SECRET_KEY_NOTESINDIA_2026
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
MAX_UPLOAD_SIZE_MB=50

# Internal Service-to-Service Auth (Java Backend <-> Python AI Service)
# NEVER expose this key to the frontend!
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_API_KEY=CHANGE_ME_INTERNAL_AI_SERVICE_SECRET_KEY_NOTESINDIA
AI_SERVICE_TIMEOUT_SECONDS=180

# Python AI Service (Padhaku AI) & Local LLM (Ollama)
AI_SERVICE_PORT=8000
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
# Configurable local models based on available hardware:
#   qwen2.5:1.5b (~1.0 GB RAM, recommended for 8 GB CPU-only machines)
#   qwen2.5:3b   (~2.0 GB RAM, 12-16 GB RAM machines)
#   qwen3:8b     (~5.2 GB RAM/VRAM, 16+ GB RAM or GPU)
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TEMPERATURE=0.2
OLLAMA_CONNECT_TIMEOUT=10
OLLAMA_READ_TIMEOUT=180
OLLAMA_NUM_CTX=4096
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_TYPE=faiss
VECTOR_STORE_DIR=/app/data/vectorstore
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MIN_SCORE=0.15

# Frontend
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080/api


